{
  // A Linux machine for Tracefix's strict mode (bubblewrap), which only runs on Linux: run the
  // Linux tests here before pushing instead of spending CI minutes. See .devcontainer/README.md.
  "name": "tracefix",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  // bubblewrap makes its own namespaces; Docker's default seccomp and AppArmor profiles block
  // that inside a container, and Docker hides parts of /proc, so the kernel refuses the fresh
  // /proc Tracefix's sandbox mounts (`--proc /proc`) unless `systempaths=unconfined`. This
  // machine is a throwaway cloud VM, not the user's computer.
  "capAdd": ["SYS_ADMIN"],
  "securityOpt": ["seccomp=unconfined", "apparmor=unconfined", "systempaths=unconfined"],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "containerEnv": {
    // Fail instead of silently falling back to basic isolation, as Linux CI does.
    "TRACEFIX_REQUIRE_STRICT": "1"
  },
  // uv's installer puts it in ~/.local/bin, which isn't on the terminal's PATH by default.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
